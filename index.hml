<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TAKING V6</title><style>*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:#0a0a12;color:#fff;display:flex;justify-content:center;align-items:center;height:100vh}#g{width:100%;max-width:400px;height:100vh;background:#111;position:relative}canvas{width:100%;height:70vh;background:#0f0f1a;display:block}#u{text-align:center;padding:15px}h1{color:#a855f7}#btn{background:#a855f7;color:#fff;border:0;padding:12px 30px;border-radius:30px;font-size:18px;font-weight:bold;margin-top:10px}</style></head><body><div id="g"><canvas id="c"></canvas><div id="u"><h1>TAKING V6</h1><div id="s">SCORE: 0</div><button id="btn">START GAME</button></div></div><script>
const C=document.getElementById('c'),X=C.getContext('2d');C.width=400;C.height=560;let P={x:180,y:400,w:30,h:30},E=[],B=[],S=0,PL=false,keys={};
document.getElementById('btn').onclick=()=>{if(!PL){PL=true;S=0;E=[];B=[];document.getElementById('btn').innerText='FIRE';loop();sp()}else{B.push({x:P.x+12,y:P.y,w:6,h:10})}};
function sp(){if(!PL)return;E.push({x:Math.random()*370,y:-30,w:28,h:28});setTimeout(sp,800)}
function loop(){if(!PL)return;X.clearRect(0,0,400,560);if(keys['ArrowLeft']||keys['a'])P.x-=5;if(keys['ArrowRight']||keys['d'])P.x+=5;if(keys['ArrowUp']||keys['w'])P.y-=5;if(keys['ArrowDown']||keys['s'])P.y+=5;P.x=Math.max(0,Math.min(370,P.x));P.y=Math.max(0,Math.min(530,P.y));X.fillStyle='#a855f7';X.fillRect(P.x,P.y,P.w,P.h);E.forEach((e,i)=>{e.y+=2;X.fillStyle='#ef4444';X.fillRect(e.x,e.y,e.w,e.h);if(e.y>600)E.splice(i,1);if(P.x<e.x+e.w&&P.x+P.w>e.x&&P.y<e.y+e.h&&P.y+P.h>e.y){PL=false;document.getElementById('btn').innerText='GAME OVER - RESTART'}});B.forEach((b,i)=>{b.y-=7;X.fillStyle='#fbbf24';X.fillRect(b.x,b.y,b.w,b.h);if(b.y<0)B.splice(i,1);E.forEach((e,j)=>{if(b.x<e.x+e.w&&b.x+b.w>e.x&&b.y<e.y+e.h&&b.y+b.h>e.y){E.splice(j,1);B.splice(i,1);S+=10;document.getElementById('s').innerText='SCORE: '+S}})});requestAnimationFrame(loop)}window.addEventListener('keydown',e=>keys[e.key]=true);window.addEventListener('keyup',e=>keys[e.key]=false);C.addEventListener('touchstart',()=>{if(PL)B.push({x:P.x+12,y:P.y,w:6,h:10})});let sx=0; C.addEventListener('touchmove',e=>{let t=e.touches[0];if(sx==0)sx=t.clientX; P.x+= (t.clientX-sx)*0.1; sx=t.clientX});C.addEventListener('touchend',()=>sx=0);
</script></body></html>
